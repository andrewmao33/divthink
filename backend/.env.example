# Copy to .env and fill in. .env is gitignored. In production, set these on the host instead.

DATABASE_URL=postgresql://divthink:divthink@localhost:5433/divthink

# Encrypts users' saved API keys. Generate one with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KEY_ENCRYPTION_KEY=

# Sign-in with Supabase Auth (https://<project-ref>.supabase.co). Leave empty locally
# to skip sign-in and use a built-in dev user.
SUPABASE_URL=

# Local development without sign-in: the dev user's provider keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Production only:
# ENVIRONMENT=production
# CORS_ORIGINS=https://divthink.com,https://www.divthink.com
