# Frontend settings. For local sign-in testing copy to .env.local; for production set
# these in Vercel (Project → Settings → Environment Variables). All are public in the
# browser: never put secrets here.

# Backend URL. Leave empty locally to use the Vite dev proxy (/api -> localhost:8000).
VITE_API_URL=

# Supabase project (Project Settings → API). Leave empty locally to skip sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
